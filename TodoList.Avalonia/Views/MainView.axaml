<UserControl
    x:Class="TodoList.Avalonia.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TodoList.Avalonia.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="False"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto">

        <ItemsControl
            MinHeight="40"
            Background="#333"
            ItemsSource="{Binding Employeers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button
                        Margin="6,2"
                        Padding="3"
                        BorderBrush="LightBlue"
                        BorderThickness="1"
                        Command="{Binding $parent[ItemsControl].DataContext.ChangeSelectedEmployeerCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding name}"
                        CornerRadius="4"
                        FontSize="16"
                        Foreground="White" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            Background="LemonChiffon"
            Foreground="Black"
            GridLinesVisibility="All"
            ItemsSource="{Binding JobItems}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding start_date, StringFormat={}{0:dd.MM.yyyy}}"
                    FontSize="13"
                    Foreground="LightBlue"
                    Header="Создано" />
                <DataGridTextColumn
                    Binding="{Binding end_date, StringFormat={}{0:dd.MM.yyyy}}"
                    FontSize="13"
                    Foreground="LightBlue"
                    Header="Выполнено" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding title}"
                    FontSize="15"
                    Foreground="Navy"
                    Header="Заголовок" />
                <DataGridTextColumn
                    Binding="{Binding price}"
                    FontSize="15"
                    FontWeight="Bold"
                    Header="Цена" />
                <DataGridTextColumn
                    Binding="{Binding website}"
                    FontSize="13"
                    Foreground="RoyalBlue"
                    Header="Сайт" />
                <DataGridTemplateColumn Header="Оплачено">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding is_payed}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Выполнено">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding is_completed}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <StackPanel
            Grid.Row="2"
            MinHeight="24"
            Background="#333"
            Orientation="Horizontal">

            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="6,2,2,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="White"
                    Text="Выполненных неоплаченных на сумму: " />
                <TextBlock
                    Margin="6,2,2,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding CurrentEmployeerUnpaidCompletedTotalSum, FallbackValue=0 руб.}" />
            </StackPanel>

        </StackPanel>
    </Grid>

</UserControl>
