<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="TextBlock" x:Key="EmployeerPaymentStatisticsSum">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8 4 4 4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource MoneyGreenBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="EmployeerPaymentStatisticsPercentChange">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8 4 4 4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#BB0000"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="ColumnTitleTextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5 10"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#333"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
</ResourceDictionary>