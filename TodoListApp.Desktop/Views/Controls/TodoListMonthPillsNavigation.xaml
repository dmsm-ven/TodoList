<UserControl
    x:Class="TodoListApp.Desktop.Views.Controls.TodoListMonthPillsNavigation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:con="clr-namespace:TodoListApp.Desktop.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TodoListApp.Desktop.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mod="clr-namespace:TodoListApp.Desktop.Models.TodoList"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type={x:Type mod:EmployeerTabViewModel},
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border Style="{StaticResource ColumnBorderStyle}">
        <DockPanel>
            <!--  Стрелки прокрутки: показываются только когда плитки не помещаются в панель  -->
            <ui:Button
                x:Name="ScrollLeftButton"
                MinHeight="30"
                Margin="2,2,0,2"
                Padding="4,0"
                VerticalAlignment="Center"
                Appearance="Transparent"
                Click="OnScrollLeftClick"
                DockPanel.Dock="Left"
                Icon="{ui:SymbolIcon ChevronLeft24}"
                Visibility="Collapsed" />
            <ui:Button
                x:Name="ScrollRightButton"
                MinHeight="30"
                Margin="0,2,2,2"
                Padding="4,0"
                VerticalAlignment="Center"
                Appearance="Transparent"
                Click="OnScrollRightClick"
                DockPanel.Dock="Right"
                Icon="{ui:SymbolIcon ChevronRight24}"
                Visibility="Collapsed" />

            <!--  Полоса прокрутки скрыта (раньше перекрывала кнопки): прокрутка колесом мыши и стрелками  -->
            <ScrollViewer
                x:Name="PillsScrollViewer"
                MinHeight="30"
                BorderThickness="0"
                HorizontalScrollBarVisibility="Hidden"
                PreviewMouseWheel="OnPillsPreviewMouseWheel"
                ScrollChanged="OnPillsScrollChanged"
                VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding MonthPills}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <con:TodoListMonthPillItem Margin="2,2,8,2" IsSelectedPill="{Binding IsSelected}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button
                        Margin="2,2,8,2"
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        Command="{Binding ShowMoreMonthPillsCommand}"
                        Content="Показать еще"
                        Icon="{ui:SymbolIcon Add24}"
                        Visibility="{Binding HasHiddenMonthPills, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
