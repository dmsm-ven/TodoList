<UserControl
    x:Class="TodoListApp.Desktop.Views.Controls.TodoListTabContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:con="clr-namespace:TodoListApp.Desktop.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ss="clr-namespace:LoadingSpinnerControl;assembly=LoadingSpinnerControl"
    xmlns:vm="clr-namespace:TodoListApp.Desktop.Models.TodoList"
    d:DataContext="{d:DesignInstance Type=vm:EmployeerTabViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="400"
    d:DesignWidth="800"
    Background="Transparent"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources />

        <!--  Панель поиска, заголовка и добавления задачи  -->
        <DockPanel
            Grid.Row="0"
            LastChildFill="True">
            <ui:Button
                Appearance="Transparent"
                Command="{Binding AddJobItemCommand}"
                DockPanel.Dock="Left"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                Icon="{ui:SymbolIcon Symbol=Add24,
                                     FontSize=24}" />

            <TextBlock
                DockPanel.Dock="Left"
                Style="{StaticResource ColumnTitleTextBlock}"
                Text="Добавить задачу" />

            <ui:TextBox
                Width="240"
                MinWidth="200"
                Margin="0,0,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                d:Text="Поисковый запрос"
                ClearButtonEnabled="True"
                PlaceholderText="Поиск ..."
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

        </DockPanel>

        <!--  Список оплат от работодателя  -->

        <!--  ГЛАВНАЯ панель с задачами  -->
        <Border
            Grid.Row="1"
            Style="{StaticResource ColumnBorderStyle}">

            <con:TodoListTabTableView DataContext="{Binding}" />

        </Border>

        <!--  Кнопки навигации по месяцам  -->
        <con:TodoListMonthPillsNavigation
            Grid.Row="2"
            DataContext="{Binding}" />

        <!--  Статус бар  -->
        <con:TodoListTabStatusBar
            Grid.Row="3"
            MinHeight="20"
            DataContext="{Binding StatusBarData}" />

        <!--  индикатор загрузки вкладки  -->
        <ss:LoadingSpinner
            Grid.Row="1"
            Width="200"
            Height="200"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Panel.ZIndex="10"
            IsLoading="True"
            Opacity="0.75"
            Thickness="6"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
            Color="RoyalBlue" />
    </Grid>
</UserControl>
