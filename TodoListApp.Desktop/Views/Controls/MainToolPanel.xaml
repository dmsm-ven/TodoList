<UserControl
    x:Class="TodoListApp.Desktop.Views.Controls.MainToolPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mod="clr-namespace:TodoListApp.Desktop.Models"
    xmlns:vm="clr-namespace:TodoListApp.Desktop.ViewModels"
    Height="50"
    d:DesignHeight="40"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <DockPanel Background="{StaticResource ToolPanelBackground}" LastChildFill="True">
        <DockPanel.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="6,2,30,2" />
                <Setter Property="Foreground" Value="White" />
            </Style>
        </DockPanel.Resources>
        <!--  Основная панель навигации по категориям программы  -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
            <StackPanel.Resources>
                <Style TargetType="{x:Type icons:PackIconFontAwesome}">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                </Style>
            </StackPanel.Resources>

            <Button Command="{Binding MoveToTodoListCommand}" Style="{StaticResource ToolButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconFontAwesome Kind="ListSolid" />
                    <TextBlock Text="Список задач" />
                </StackPanel>
            </Button>




        </StackPanel>

        <!--  Кнопки минимизации/закрытия приложения  -->
