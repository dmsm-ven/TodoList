<UserControl
    x:Class="TodoListApp.Desktop.Views.Controls.MainToolPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Height="50"
    d:DesignHeight="40"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <DockPanel Background="{StaticResource ToolPanelBackground}" LastChildFill="True">
        <!--  Основная панель навигации по категориям программы  -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
            <ui:Button
                Margin="8,4"
                Appearance="Transparent"
                Command="{Binding MoveToTodoListCommand}"
                Content="Список задач"
                Foreground="White"
                Icon="{ui:SymbolIcon TextBulletListLtr24}" />
        </StackPanel>
    </DockPanel>
</UserControl>
