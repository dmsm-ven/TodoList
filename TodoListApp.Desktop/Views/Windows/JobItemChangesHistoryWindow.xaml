<ui:FluentWindow
    x:Class="TodoListApp.Desktop.Views.JobItemChangesHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TodoListApp.Desktop.ViewModels.Windows"
    Title="Журнал изменений задачи"
    Width="593"
    Height="450"
    d:DataContext="{d:DesignInstance Type=vm:JobItemChangesHistoryWindowViewModel,
                                     IsDesignTimeCreatable=False}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <beh:Interaction.Triggers>
        <beh:EventTrigger EventName="Loaded">
            <beh:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </beh:EventTrigger>
    </beh:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Журнал изменений задачи" ShowMaximize="False" ShowMinimize="False" />

        <DataGrid
            Grid.Row="1"
            Margin="8,0,8,8"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            IsReadOnly="True"
            ItemsSource="{Binding HistoryItems}"
            VerticalGridLinesBrush="Transparent">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding LocalTime, ConverterCulture=ru-RU}"
                    Header="Дата/Время" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Elapsed}"
                    Header="Прошло" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding ChangedPropertyName}"
                    Header="Измененное поле" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding NewValue}"
                    Header="Новое значение" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</ui:FluentWindow>
