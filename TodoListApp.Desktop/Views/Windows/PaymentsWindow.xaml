<ui:FluentWindow
    x:Class="TodoListApp.Desktop.Views.PaymentsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TodoListApp.Desktop.Models.TodoList"
    Title="Оплаты"
    Width="460"
    Height="620"
    d:DataContext="{d:DesignInstance Type={x:Type vm:EmployeerTabViewModel},
                                     IsDesignTimeCreatable=False}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{Binding Employeer.Name, StringFormat='Оплаты: {0}'}"
            ShowMaximize="False"
            ShowMinimize="False" />

        <!--  Заголовок и добавление оплаты  -->
        <Grid Grid.Row="1" Margin="16,4,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <ui:SymbolIcon
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="30"
                    Foreground="{StaticResource MoneyGreenBrush}"
                    Symbol="Money24" />
                <TextBlock Style="{StaticResource ColumnTitleTextBlock}" Text="Оплаты" />
                <ui:Button
                    Appearance="Transparent"
                    Command="{Binding ShowPaymentFieldCommand}"
                    Foreground="{StaticResource MoneyGreenBrush}"
                    Icon="{ui:SymbolIcon Symbol=Add24,
                                         FontSize=24}"
                    ToolTip="Добавить оплату" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                Visibility="{Binding IsShowPaymentField, Converter={StaticResource BoolToVisibilityConverter}}">
                <DatePicker Margin="2,2,6,2" SelectedDate="{Binding NewPayment.TransferArrivalDate}" />
                <TextBox
                    MinWidth="80"
                    Margin="5,2"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="{Binding NewPayment.Amount, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button
                    Appearance="Transparent"
                    Command="{Binding AddEmployeerPaymentCommand}"
                    Foreground="{StaticResource MoneyGreenBrush}"
                    Icon="{ui:SymbolIcon Symbol=ArrowDownload24,
                                         FontSize=24}"
                    ToolTip="Сохранить оплату" />
            </StackPanel>
        </Grid>

        <!--  Список оплат  -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,0,16,16">
                <Border Style="{StaticResource ColumnBorderStyle}">
                    <ItemsControl ItemsSource="{Binding Employeer.SortedPayments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="6,6,20,6"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Text="{Binding TransferArrivalDate, StringFormat='dd.MM.yyyy'}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource MoneyGreenBrush}"
                                        Text="{Binding Amount, StringFormat={}{0:F0}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <ui:Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Appearance="Secondary"
                    Command="{Binding Employeer.ShowMorePaymentsCommand}"
                    Content="Показать еще"
                    Icon="{ui:SymbolIcon Add24}"
                    Visibility="{Binding Employeer.HasHiddenPayments, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
