<ui:FluentWindow
    x:Class="TodoListApp.Desktop.Views.ConnectionErrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TodoListApp.Desktop.ViewModels.Windows"
    Title="Ошибка"
    Width="400"
    Height="600"
    d:DataContext="{d:DesignInstance Type=vm:ConnectionErrorWindowViewModel,
                                     IsDesignTimeCreatable=True}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Ошибка" ShowMaximize="False" ShowMinimize="False" />

        <ui:SymbolIcon
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="160"
            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
            Symbol="Warning24" />
        <TextBlock
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            d:Text="Ошибка соединения с базой данных ..."
            FontSize="14"
            Text="{Binding ErrorMessage}"
            TextWrapping="Wrap" />
        <ui:Button
            Grid.Row="3"
            Margin="16"
            HorizontalAlignment="Center"
            Appearance="Danger"
            Command="{Binding CloseApplicationCommand}"
            Content="Закрыть"
            Icon="{ui:SymbolIcon Dismiss24}" />
    </Grid>
</ui:FluentWindow>
