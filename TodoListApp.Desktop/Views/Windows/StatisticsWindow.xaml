<ui:FluentWindow
    x:Class="TodoListApp.Desktop.Views.StatisticsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:con="clr-namespace:TodoListApp.Desktop.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TodoListApp.Desktop.ViewModels"
    Title="Статистика"
    Width="900"
    Height="720"
    d:DataContext="{d:DesignInstance Type=vm:StatisticsViewModel,
                                     IsDesignTimeCreatable=False}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Статистика" ShowMaximize="False" ShowMinimize="False" />

        <!--  Выбор работодателя  -->
        <StackPanel
            Grid.Row="1"
            Margin="16,4,16,8"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Работодатель:" />
            <ComboBox
                MinWidth="260"
                DisplayMemberPath="Employeer.Name"
                ItemsSource="{Binding Employeers}"
                SelectedItem="{Binding SelectedTab}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,0,16,16">

                <!--  Итоги по выполненным задачам  -->
                <TextBlock
                    Margin="0,8,0,8"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="Выполненные задачи" />
                <UniformGrid Columns="4">
                    <UniformGrid.Resources>
                        <Style x:Key="CardTitle" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Style>
                        <Style x:Key="CardValue" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="22" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </UniformGrid.Resources>
                    <ui:Card Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Выполнено" />
                            <TextBlock Style="{StaticResource CardValue}" Text="{Binding CompletedCount}" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="На сумму" />
                            <TextBlock Style="{StaticResource CardValue}" Text="{Binding TotalSum, StringFormat={}{0:C0}}" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Оплачено" />
                            <TextBlock
                                Foreground="{StaticResource MoneyGreenBrush}"
                                Style="{StaticResource CardValue}"
                                Text="{Binding PaidSum, StringFormat={}{0:C0}}" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Не оплачено" />
                            <TextBlock
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource CardValue}"
                                Text="{Binding NotPaidSum, StringFormat={}{0:C0}}" />
                        </StackPanel>
                    </ui:Card>
                </UniformGrid>

                <Expander
                    Margin="0,12,0,0"
                    Header="По месяцам"
                    IsExpanded="False">
                    <StackPanel Margin="0,8,0,0">
                    <DataGrid
                        MaxHeight="260"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        IsReadOnly="True"
                        ItemsSource="{Binding Months}"
                        VerticalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Month}"
                                Header="Месяц" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding CompletedCount}"
                                Header="Задач" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Total, StringFormat={}{0:C0}}"
                                Header="Сумма" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Paid, StringFormat={}{0:C0}}"
                                Header="Оплачено" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding NotPaid, StringFormat={}{0:C0}}"
                                Header="Не оплачено" />
                        </DataGrid.Columns>
                    </DataGrid>
                    </StackPanel>
                </Expander>
                <Expander
                    Margin="0,12,0,0"
                    Header="Динамика за 12 месяцев"
                    IsExpanded="False">
                    <StackPanel Margin="0,8,0,0">
                    <sp:WpfPlot x:Name="DynamicsPlot" Height="260" />
                    <DataGrid
                        MaxHeight="360"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        IsReadOnly="True"
                        ItemsSource="{Binding Dynamics}"
                        VerticalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Month}"
                                Header="Месяц" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding CompletedCount}"
                                Header="Задач" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding Total, StringFormat={}{0:C0}}"
                                Header="Сумма" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding ChangeToPrevious}"
                                Header="К пред. мес." />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding ChangeToLastYear}"
                                Header="К прошл. году" />
                        </DataGrid.Columns>
                    </DataGrid>
                    </StackPanel>
                </Expander>
                <Expander
                    Margin="0,12,0,0"
                    Header="Сравнение работодателей"
                    IsExpanded="False">
                    <StackPanel Margin="0,8,0,0">
                    <sp:WpfPlot x:Name="ComparisonPlot" Height="260" />
                    <DataGrid
                        MaxHeight="300"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        IsReadOnly="True"
                        ItemsSource="{Binding Comparison}"
                        VerticalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                Header="Работодатель" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding CompletedCount}"
                                Header="Задач" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding Total, StringFormat={}{0:C0}}"
                                Header="Сумма" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding SharePercent, StringFormat={}{0:F0}%}"
                                Header="Доля" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding AveragePrice, StringFormat={}{0:C0}}"
                                Header="Ср. цена" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding AverageDays}"
                                Header="Ср. срок" />
                        </DataGrid.Columns>
                    </DataGrid>
                    </StackPanel>
                </Expander>
                <Expander
                    Margin="0,12,0,0"
                    Header="Оплаты"
                    IsExpanded="False">
                    <StackPanel Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DataGrid
                            Grid.Column="0"
                            MaxHeight="260"
                            Margin="0,0,16,0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            IsReadOnly="True"
                            ItemsSource="{Binding Payments}"
                            VerticalGridLinesBrush="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding TransferArrivalDate, StringFormat='dd.MM.yyyy'}"
                                    Header="Дата" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Amount, StringFormat={}{0:C0}}"
                                    Header="Сумма" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <con:TodoListTabEmployeerPaymentStatistics Grid.Column="1" DataContext="{Binding PaymentsStatistic}" />
                    </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
