<UserControl
    x:Class="TodoListApp.Desktop.Views.TodoListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:con="clr-namespace:TodoListApp.Desktop.Views.Controls"
    xmlns:converters="clr-namespace:TodoListApp.Desktop.Infrastructure.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ss="clr-namespace:LoadingSpinnerControl;assembly=LoadingSpinnerControl"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TodoListApp.Desktop.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:TodoListViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="400"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <beh:Interaction.Triggers>
        <beh:EventTrigger EventName="Loaded">
            <beh:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </beh:EventTrigger>
    </beh:Interaction.Triggers>
    <Grid>
        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="10"
            Orientation="Horizontal">
            <ui:Button
                Appearance="Transparent"
                Command="{Binding ShowAppSettingsWindowCommand}"
                Icon="{ui:SymbolIcon Symbol=Settings24,
                                     FontSize=20}"
                ToolTip="Настройки" />
            <ui:Button
                Appearance="Transparent"
                Command="{Binding ShowStatisticsWindowCommand}"
                Icon="{ui:SymbolIcon Symbol=DataBarVertical24,
                                     FontSize=20}"
                ToolTip="Статистика" />
            <ui:Button
                Appearance="Transparent"
                Command="{Binding ShowPaymentsWindowCommand}"
                Foreground="{StaticResource MoneyGreenBrush}"
                Icon="{ui:SymbolIcon Symbol=Money24,
                                     FontSize=20}"
                ToolTip="Оплаты" />
        </StackPanel>

        <TabControl
            BorderThickness="0"
            ItemsSource="{Binding Tabs}"
            SelectedValue="{Binding SelectedTab}">
            <TabControl.Resources>
                <!--  Более заметное выделение выбранной вкладки (полупрозрачный акцент виден в обеих темах)  -->
                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#664169E1" />
                <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="#4169E1" />
                <!--  Контекстное меню на общей панели заголовков вкладок  -->
                <Style TargetType="TabPanel">
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <ui:MenuItem
                                    Command="{Binding PlacementTarget.DataContext.AddNewEmployeerTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    Header="Добавить работодателя"
                                    Icon="{ui:SymbolIcon PersonAdd24}" />
                                <ui:MenuItem
                                    Command="{Binding PlacementTarget.DataContext.RemoveEmployeerTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                    Header="Удалить текущего работодателя"
                                    Icon="{ui:SymbolIcon PersonDelete24}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <con:TodoListTabContent DataContext="{Binding}" />
                </DataTemplate>
            </TabControl.ContentTemplate>
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Grid Margin="8,2,2,2">
                            <Ellipse
                                Width="28"
                                Height="28"
                                Fill="{Binding HasActiveTasks, Converter={StaticResource HasActiveTaskBrushConverter}}"
                                Stroke="Transparent" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                d:Text="99"
                                FontSize="14"
                                Foreground="White"
                                Text="{Binding ActiveTasksCount}" />
                        </Grid>

                        <TextBlock
                            Margin="8,4,2,2"
                            Background="Transparent"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Employeer.Name, TargetNullValue='Имя'}" />

                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>

        <ss:LoadingSpinner
            Width="64"
            Height="64"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="10"
            IsLoading="True"
            Opacity="0.75"
            Thickness="6"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
            Color="RoyalBlue" />
    </Grid>
</UserControl>
