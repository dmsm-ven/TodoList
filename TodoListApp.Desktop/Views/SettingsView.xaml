<UserControl x:Class="TodoList.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:v="clr-namespace:TodoList.WPF.Views"
             xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=v:SettingsView, IsDesignTimeCreatable=True}"
             d:Background="White"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <beh:Interaction.Triggers>
        <beh:EventTrigger EventName="Loaded">
            <beh:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </beh:EventTrigger>
    </beh:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <CheckBox Content="Поверх всех окон" 
                      IsChecked="{Binding IsTopmost, UpdateSourceTrigger=PropertyChanged}"
                      VerticalAlignment="Center" Margin="4"/>
        </Grid>
        
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Журнал приложения" FontSize="24" HorizontalAlignment="Center" Foreground="White"/>
            <DataGrid Grid.Row="1" IsReadOnly="True" 
                  VerticalGridLinesBrush="Transparent"
                  HorizontalGridLinesBrush="LightGray"
                  FontSize="16"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Hidden"
                  AutoGenerateColumns="False" 
                  ItemsSource="{Binding LogEntries}">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="20"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn 
                    Foreground="Blue"
                    Binding="{Binding DateTime, ConverterCulture=ru-RU}" Header="Дата/Время" />
                    <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
               
    </Grid>
</UserControl>
