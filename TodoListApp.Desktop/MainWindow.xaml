<Window
    x:Class="TodoList.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:con="clr-namespace:TodoList.WPF.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="clr-namespace:TodoList.WPF.Views"
    xmlns:vm="clr-namespace:TodoList.WPF.ViewModels"
    xmlns:vmw="clr-namespace:TodoList.WPF.ViewModels.Windows"
    x:Name="window"
    Title="Список дел"
    Width="1600"
    Height="800"
    d:DataContext="{d:DesignInstance Type=vmw:MainWindowViewModel,
                                     IsDesignTimeCreatable=False}"
    d:Height="250"
    d:Width="1000"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <beh:Interaction.Triggers>
        <beh:EventTrigger EventName="Loaded">
            <beh:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </beh:EventTrigger>
    </beh:Interaction.Triggers>

    <Grid Background="{StaticResource MainGridImageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="1"
            Padding="20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{StaticResource MainContentBackground}"
            BorderBrush="{StaticResource ToolPanelBackground}"
            BorderThickness="1">
            <v:TodoListView DataContext="{Binding TodoListViewModel}"/>
        </Border>
    </Grid>

</Window>
