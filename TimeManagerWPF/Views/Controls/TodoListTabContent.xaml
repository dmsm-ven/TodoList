<UserControl
    x:Class="TodoList.WPF.Views.Controls.TodoListTabContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:con="clr-namespace:TodoList.WPF.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ss="clr-namespace:LoadingSpinnerControl;assembly=LoadingSpinnerControl"
    xmlns:vm="clr-namespace:TodoList.WPF.Models.TodoList"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=vm:EmployeerTabViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="400"
    d:DesignWidth="800"
    Background="Transparent"
    mc:Ignorable="d">
    <beh:Interaction.Triggers>
        <beh:EventTrigger EventName="Loaded">
            <beh:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </beh:EventTrigger>
    </beh:Interaction.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources />

        <!--  Панель поиска, заголовка и добавления задачи  -->
        <DockPanel
            Grid.Row="0"
            Grid.Column="0"
            LastChildFill="True">
            <Button
                Command="{Binding AddJobCommand}"
                DockPanel.Dock="Left"
                Style="{StaticResource ToolButtonStyle}">
                <icons:PackIconFontAwesome
                    Width="24"
                    Height="24"
                    Foreground="{StaticResource ToolPanelBackground}"
                    Kind="PlusSolid" />
            </Button>

            <TextBlock
                DockPanel.Dock="Left"
                Style="{StaticResource ColumnTitleTextBlock}"
                Text="Добавить задачу" />

            <Grid
                Width="200"
                Height="26"
                MinWidth="200"
                HorizontalAlignment="Right">
                <TextBox
                    Padding="2"
                    HorizontalContentAlignment="Right"
                    VerticalContentAlignment="Center"
                    d:Text="Поисковый запрос"
                    FontFamily="Consolas"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#E71421"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                <TextBlock
                    Margin="2,2,8,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Panel.ZIndex="99"
                    FontSize="13"
                    Foreground="LightGray"
                    Text="Поиск ..."
                    Visibility="{Binding SearchText, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='inverse'}" />
            </Grid>

        </DockPanel>

        <!--  Список оплат от работодателя  -->

        <!--  ГЛАВНАЯ панель с задачами  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Style="{StaticResource ColumnBorderStyle}">

            <con:TodoListTabTableView DataContext="{Binding}" />

        </Border>

        <!--  Статистика по оплатам  -->
        <con:TodoListPaymentsPanel
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"
            DataContext="{Binding}" />

        <!--  Кнопки навигации по месяцам  -->
        <con:TodoListMonthPillsNavigation
            Grid.Row="2"
            Grid.Column="0"
            DataContext="{Binding}" />

        <!--  Статус бар  -->
        <con:TodoListTabStatusBar
            Grid.Row="3"
            Grid.ColumnSpan="2"
            MinHeight="20"
            DataContext="{Binding StatusBarData}" />

        <!--  индикатор загрузки вкладки  -->
        <ss:LoadingSpinner
            Grid.Row="1"
            Grid.Column="0"
            Width="200"
            Height="200"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Panel.ZIndex="10"
            IsLoading="True"
            Opacity="0.75"
            Thickness="6"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
            Color="RoyalBlue" />
    </Grid>
</UserControl>
