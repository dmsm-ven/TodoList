<UserControl x:Class="TodoList.WPF.Controls.TodoListTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TodoList.WPF.ViewModels"
             xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:ss="clr-namespace:LoadingSpinnerControl;assembly=LoadingSpinnerControl"
             xmlns:con="clr-namespace:TodoList.WPF.Controls"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" 
             d:DataContext="{d:DesignInstance Type=vm:TodoListTabViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d"            
             d:Background="White"
             Background="Transparent"
             d:DesignHeight="400" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" MinWidth="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="TextBlock" x:Key="ColumnTitleTextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="5 10"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="#333"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            <Style TargetType="Border" x:Key="ColumnBorderStyle">
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="BorderBrush" Value="LightGray"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="2"/>
            </Style>
            <Style TargetType="{x:Type icons:PackIconFontAwesome}" x:Key="TitleIconStyle">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="10 5"/>
            </Style>
        </Grid.Resources>

        <!-- Панель поиска, заголовка и добавления задачи-->
        <DockPanel Grid.Row="0" Grid.Column="0" LastChildFill="True">
            <Button Command="{Binding AddJobCommand}" Style="{StaticResource ToolButtonStyle}" DockPanel.Dock="Left">
                <icons:PackIconFontAwesome Kind="PlusSolid" Foreground="{StaticResource ToolPanelBackground}" Width="24" Height="24" />
            </Button>

            <TextBlock Text="Добавить задачу" 
                       DockPanel.Dock="Left"
                       Style="{StaticResource ColumnTitleTextBlock}"/>

            <icons:PackIconFontAwesome Kind="SearchLocationSolid" 
                                       Foreground="LightGray" Width="28" Height="28"
                                       VerticalAlignment="Center"
                                       Margin="16 2 8 2"
                                       DockPanel.Dock="Right"
                                       Style="{StaticResource TitleIconStyle}"/>

            <Grid HorizontalAlignment="Right" MinWidth="200" Width="200" Height="26">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                         FontSize="16"
                         d:Text="Поисковый запрос"
                         Foreground="#E71421"
                         FontWeight="SemiBold"
                         FontFamily="Consolas"
                         VerticalContentAlignment="Center"
                         Padding="2"
                         HorizontalContentAlignment="Right"/>
                <TextBlock Text="Поиск ..." Foreground="LightGray" 
                           Visibility="{Binding SearchText, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='inverse'}"
                           FontSize="13" 
                           Panel.ZIndex="99"
                           Margin="2 2 8 2"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

        </DockPanel>

        <!-- Список оплат от работодателя -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <icons:PackIconFontAwesome Kind="MoneyCheckSolid" Foreground="{StaticResource MoneyGreenBrush}" Style="{StaticResource TitleIconStyle}"/>
                <TextBlock Text="Оплаты" Style="{StaticResource ColumnTitleTextBlock}"/>
                <Button Command="{Binding ShowPaymentFieldCommand}" Style="{StaticResource ToolButtonStyle}" >
                    <icons:PackIconFontAwesome Kind="PlusSolid" Foreground="{StaticResource MoneyGreenBrush}" Width="24" Height="24" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" 
                        Visibility="{Binding IsShowPaymentField, Converter={StaticResource BoolToVisibilityConverter}}">
                <DatePicker SelectedDate="{Binding NewPayment.TransferArrivalDate}" 
                            Margin="2 2 6 2"/>
                <TextBox Text="{Binding NewPayment.Amount, UpdateSourceTrigger=PropertyChanged}" 
                         HorizontalContentAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="Red"
                         FontWeight="Bold"
                         FontSize="18"
                         MinWidth="60" BorderThickness="0 0 0 2" Margin="5 2"/>
                <Button Command="{Binding AddEmployeerPaymentCommand}" Style="{StaticResource ToolButtonStyle}" >
                    <icons:PackIconFontAwesome Kind="DownloadSolid" Foreground="{StaticResource MoneyGreenBrush}" Width="24" Height="24" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ГЛАВНАЯ панель с задачами -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ColumnBorderStyle}">
            <con:TodoListTabMainTable DataContext="{Binding}" />
        </Border>
               
        <!-- Статистика по оплатам-->
        <DockPanel Grid.Row="1" Grid.Column="1" Grid.RowSpan="2">
            <Border DockPanel.Dock="Bottom" Style="{StaticResource ColumnBorderStyle}">
                <StackPanel DataContext="{Binding PaymentsStatistic}">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="Foreground" Value="{StaticResource MoneyGreenBrush}"/>

                        </Style>
                        <Style TargetType="Label">
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </StackPanel.Resources>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="Статистика" Style="{StaticResource ColumnTitleTextBlock}"/>
                        <icons:PackIconFontAwesome Kind="ChartBarRegular" Foreground="{StaticResource ToolPanelBackground}" Style="{StaticResource TitleIconStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="За 1  мес." />
                        <TextBlock d:Text="1 000 руб." Text="{Binding Month1Sum, StringFormat={}{0:C0}, ConverterCulture=ru-RU}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="За 3  мес." />
                        <TextBlock d:Text="5 000 руб." Text="{Binding Month3Sum, StringFormat={}{0:C0}, ConverterCulture=ru-RU}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="За 6  мес." />
                        <TextBlock d:Text="10 000 руб." Text="{Binding Month6Sum, StringFormat={}{0:C0}, ConverterCulture=ru-RU}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="За 12 мес." />
                        <TextBlock d:Text="20 000 руб." Text="{Binding Month12Sum, StringFormat={}{0:C0}, ConverterCulture=ru-RU}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ColumnBorderStyle}">
                <ItemsControl ItemsSource="{Binding SortedEmployeerPayments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding TransferArrivalDate, StringFormat='dd.MM.yyyy'}"
                                       VerticalAlignment="Center"
                                       Foreground="Blue" FontSize="14" Margin=" 6 6 20 6"/>

                                <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat={}{0:F0}}" FontWeight="Bold" FontSize="16" 
                                       Foreground="{StaticResource MoneyGreenBrush}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="6"/>

                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DockPanel>
            
        <!-- Кнопки навигации по месяцам-->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ColumnBorderStyle}">
            <ScrollViewer Grid.Row="2" 
                      BorderThickness="0" 
                      MinHeight="30"                                     
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding MonthPills}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding MonthPillClickCommand}"
                                    Content="{Binding DisplayName}"
                                    Foreground="{Binding IsActive, Converter={StaticResource BoolToBrushConverter}, 
                                        ConverterParameter='#90EE90;#ffffff'}"
                                    Background="RoyalBlue"
                                    MinWidth="80"
                                    HorizontalContentAlignment="Center"
                                    Margin="2 2 8 2"
                                    Padding="8 2 8 4"
                                    FontSize="18" >
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Статус бар -->
        <con:TodoListTabStatusBar Grid.Row="3" Grid.ColumnSpan="2" MinHeight="20" DataContext="{Binding StatusBarData}"/>

        <!-- индикатор загрузки вкладки -->
        <ss:LoadingSpinner IsLoading="True" 
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                           Width="200" Height="200" 
                           HorizontalAlignment="Stretch" 
                           VerticalAlignment="Stretch"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"
                           Color="RoyalBlue" 
                           Panel.ZIndex="10"
                           Opacity="0.75"
                           Thickness="6" Grid.Row="1" Grid.Column="0" />
    </Grid>
</UserControl>
