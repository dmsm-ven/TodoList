<UserControl
    x:Class="TodoList.WPF.Controls.TodoListTabCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TodoList.WPF.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:TodoListTabViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="200"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Основная таблица задач  -->
        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl Background="#BB000000" ItemsSource="{Binding FilteredTodoItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Width="250"
                            Height="200"
                            Margin="6,6,12,12"
                            Padding="12,6"
                            Background="{Binding IsCompleted, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#90AE55;#2D9BAB'}"
                            BorderBrush="#714C72"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="12"
                                    Direction="270"
                                    Opacity="0.75"
                                    ShadowDepth="12"
                                    Color="#464646" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBox
                                    Grid.Row="0"
                                    Height="40"
                                    Margin="0,0,0,12"
                                    Background="Transparent"
                                    BorderBrush="LightGray"
                                    BorderThickness="0,0,0,1"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding Title}"
                                    TextWrapping="Wrap" />

                                <Grid Grid.Row="1">
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                        <Style TargetType="Label">
                                            <Setter Property="Margin" Value="2,2,8,2" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="6,2,6,2" />
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />

                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Content="Создано" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{Binding StartDate, StringFormat={}dd.MM.yyyy HH:mm}" />

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Content="Цена" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding Price}" />

                                    <DockPanel
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        VerticalAlignment="Bottom"
                                        LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                            <icons:PackIconFontAwesome
                                                Width="24"
                                                Height="24"
                                                Foreground="#2E3762"
                                                Kind="LightbulbRegular" />
                                            <CheckBox IsChecked="{Binding IsCompleted}" />
                                        </StackPanel>

                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsPayed}" />
                                            <icons:PackIconFontAwesome
                                                Width="24"
                                                Height="24"
                                                Foreground="LawnGreen"
                                                Kind="MoneyBillSolid" />

                                        </StackPanel>

                                    </DockPanel>

                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>


        <!--  Панель с примечанием к выделеной задаче  -->
        <Grid Grid.Row="1" Visibility="{Binding SelectedJobItem, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="8,4,4,4"
                FontSize="14"
                Foreground="#AAAAAA"
                Text="Примечание: " />
            <TextBox
                Grid.Row="1"
                Margin="4"
                Padding="4"
                BorderBrush="#7373D4"
                BorderThickness="0,0,0,1"
                Text="{Binding SelectedJobItem.Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        </Grid>
    </Grid>

</UserControl>
