<UserControl
    x:Class="TodoList.WPF.Views.Controls.TodoListTabTableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TodoList.WPF.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:EmployeerTabViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="200"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Основная таблица задач  -->
        <DataGrid
            Grid.Row="0"
            AutoGenerateColumns="False"
            Background="Transparent"
            BorderThickness="0"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeRows="False"
            CanUserSortColumns="False"
            FontSize="15"
            HeadersVisibility="Column"
            HorizontalGridLinesBrush="LightGray"
            ItemsSource="{Binding FilteredTodoItems}"
            RowBackground="Transparent"
            RowDetailsVisibilityMode="VisibleWhenSelected"
            RowHeight="28"
            SelectedValue="{Binding SelectedJobItem}"
            SelectionMode="Single"
            VerticalGridLinesBrush="Transparent">
            <DataGrid.Resources>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Foreground" Value="Black" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2AF19F5C" />
                            <Setter Property="BorderBrush" Value="#2AF19F5C" />

                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompleted}" Value="false">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Создано">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StartDate, StringFormat='dd.MM.yyyy'}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="Blue"
                                SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="30"
                    Binding="{Binding DaysAgo, Mode=OneWay}"
                    Foreground="Gray"
                    Header="дн."
                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                    Header="Задача" />
                <DataGridTemplateColumn Width="300" Header="Сайт">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Command="{Binding OpenWebsiteInBrowserCommand}"
                                    Foreground="RoyalBlue"
                                    Style="{StaticResource ToolButtonStyle}">
                                    <icons:PackIconFontAwesome
                                        Width="16"
                                        Height="16"
                                        Kind="LinkSolid" />
                                </Button>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="RoyalBlue"
                                    Text="{Binding Website}"
                                    TextDecorations="Underline" />
                            </StackPanel>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                                IsEditable="True"
                                IsTextSearchEnabled="True"
                                ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid}, Path=DataContext.UniqueWebsites}"
                                Text="{Binding Website, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                    Header="Цена" />
                <DataGridTemplateColumn Header="Оплачено">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <icons:PackIconFontAwesome
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{Binding IsPayed, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#7cfc00;#ff2400'}"
                                Kind="{Binding IsPayed, Converter={StaticResource BoolToIconKindConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <CheckBox
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsPayed, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Выполнено">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <icons:PackIconFontAwesome
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{Binding IsCompleted, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#7cfc00;#ff2400'}"
                                Kind="{Binding IsCompleted, Converter={StaticResource BoolToIconKindConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <CheckBox
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="img">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Padding="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding OpenScreenshotsFolderCommand}"
                                Foreground="{Binding HasScreenshots, Converter={StaticResource HasActiveTaskBrushConverter}}"
                                Style="{StaticResource ToolButtonStyle}">
                                <icons:PackIconFontAwesome
                                    Width="16"
                                    Height="16"
                                    Foreground="Blue"
                                    Kind="ImageRegular" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="del">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Padding="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.DeleteJobCommand}"
                                Style="{StaticResource ToolButtonStyle}">
                                <icons:PackIconFontAwesome
                                    Width="16"
                                    Height="16"
                                    Foreground="LightGray"
                                    Kind="TrashSolid" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="his">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Padding="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding ShowChangeHistoryCommand}"
                                Style="{StaticResource ToolButtonStyle}">
                                <icons:PackIconFontAwesome
                                    Width="16"
                                    Height="16"
                                    Foreground="#6D5B51"
                                    Kind="ListSolid" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--  Панель с примечанием к выделеной задаче  -->
        <Grid Grid.Row="1" Visibility="{Binding SelectedJobItem, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="8,4,4,4"
                FontSize="14"
                Foreground="#AAAAAA"
                Text="Примечание: " />
            <TextBox
                Grid.Row="1"
                Margin="4"
                Padding="4"
                BorderBrush="#7373D4"
                BorderThickness="0,0,0,1"
                Text="{Binding SelectedJobItem.Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
        </Grid>
    </Grid>

</UserControl>
