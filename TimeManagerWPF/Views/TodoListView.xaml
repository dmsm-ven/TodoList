<UserControl x:Class="TodoList.WPF.Views.TodoListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TodoList.WPF.ViewModels"
             xmlns:converters="clr-namespace:TodoList.WPF.Infrastructure.Converters"
             xmlns:con="clr-namespace:TodoList.WPF.Controls"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"             
             xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"             
             xmlns:ss="clr-namespace:LoadingSpinnerControl;assembly=LoadingSpinnerControl"             
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TodoListViewModel, IsDesignTimeCreatable=True}"      
             d:DesignHeight="400" d:DesignWidth="900">
    <beh:Interaction.Triggers>
        <beh:EventTrigger EventName="Loaded">
            <beh:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </beh:EventTrigger>
    </beh:Interaction.Triggers>
    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Panel.ZIndex="10">
            <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding AddNewEmployeerTabCommand}" 
                    ToolTip="Создать новую вкладку с работами">
                <icons:PackIconFontAwesome Kind="UserPlusSolid" Foreground="LightGray" Width="22" Height="22" />
            </Button>
        </StackPanel>

        
        <TabControl ItemsSource="{Binding Tabs}"
                    SelectedValue="{Binding SelectedTab}"
                    
                    BorderThickness="0" >
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <con:TodoListTabContent DataContext="{Binding}"></con:TodoListTabContent>
                </DataTemplate>
            </TabControl.ContentTemplate>
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="24" Height="24" Stroke="Transparent"
                                 Margin="8 2 2 2"
                                 Fill="{Binding HasActiveTasks, Converter={StaticResource HasActiveTaskBrushConverter}}"/>
                        <TextBlock Text="{Binding Employeer.Name, TargetNullValue='Имя'}" 
                                   Background="Transparent"
                                   Foreground="Black"
                                   Margin="8 4 2 2"
                                   FontWeight="Bold" FontSize="20"/>

                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>

        <ss:LoadingSpinner IsLoading="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                           Width="64" Height="64" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Top"
                           Color="RoyalBlue" 
                           Panel.ZIndex="10"
                           Opacity="0.75"
                           Thickness="6" />
    </Grid>
</UserControl>
