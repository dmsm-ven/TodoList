<UserControl
    x:Class="TodoList.WPF.Views.BudgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:bt="TodoList.WPF.Models."
    xmlns:con="clr-namespace:TodoList.WPF.Infrastructure.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:lc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ss="clr-namespace:LoadingSpinnerControl;assembly=LoadingSpinnerControl"
    xmlns:vm="clr-namespace:TodoList.WPF.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:Background="Transparent"
    d:DataContext="{d:DesignInstance Type=vm:BudgetViewModel,
                                     IsDesignTimeCreatable=True}"
    d:Height="400"
    d:Width="800"
    mc:Ignorable="d">
    <beh:Interaction.Triggers>
        <beh:EventTrigger EventName="Loaded">
            <beh:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </beh:EventTrigger>
    </beh:Interaction.Triggers>
    <UserControl.Resources>
        <con:BudgetTypeToIconConverter x:Key="BudgetTypeToIconConverter" />
        <con:BudgetTypeToBrushConverter x:Key="BudgetTypeToBrushConverter" />
        <con:ActiveBudgetTypeToBrushConverter x:Key="ActiveBudgetTypeToBrushConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="2,2,6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush
                ImageSource="../Assets/Images/Budget/budget-background-texture.jpg"
                TileMode="Tile"
                Viewport="0,0,200,200"
                ViewportUnits="Absolute" />
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,6"
            Background="#E4333333">
            <StackPanel.Resources>
                <Style x:Key="TextBlockFilterCaption" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#40D650" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="6,2,6,2" />
                </Style>
            </StackPanel.Resources>

            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="2,2,12,2"
                    FontWeight="Bold"
                    Text="Фильтр" />

                <TextBlock Text="С" />
                <DatePicker Margin="3,6" SelectedDate="{Binding FilterStartDate}" />
                <TextBlock Text="По" />
                <DatePicker Margin="3,6" SelectedDate="{Binding FilterEndDate}" />

                <Button Command="{Binding ClearFilterCommand}" Style="{StaticResource ToolButtonStyle}">
                    <icons:PackIconFontAwesome Foreground="#FA472D" Kind="TimesSolid" />
                </Button>

            </StackPanel>

            <DockPanel
                Margin="0,4,0,6"
                HorizontalAlignment="Stretch"
                LastChildFill="True">
                <Button Command="{Binding AddNewItemCommand}" Style="{StaticResource ToolButtonStyle}">
                    <icons:PackIconFontAwesome
                        DockPanel.Dock="Left"
                        Kind="AdjustSolid"
                        Style="{StaticResource MediumIconSize}" />
                </Button>

                <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextBlockFilterCaption}">Тип</TextBlock>
                <StackPanel DockPanel.Dock="Left">
                    <StackPanel.Resources>
                        <Style TargetType="RadioButton">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Margin" Value="4,0,12,2" />
                        </Style>
                    </StackPanel.Resources>
                    <Button
                        Command="{Binding SetNewItemTypeCommand}"
                        CommandParameter="Income"
                        Foreground="{Binding NewBudgetItem.BudgetType, Converter={StaticResource ActiveBudgetTypeToBrushConverter}, ConverterParameter='Income'}"
                        Style="{StaticResource ToolButtonStyle}">
                        <icons:PackIconFontAwesome Kind="PlusSolid" Style="{StaticResource MediumIconSize}" />
                    </Button>

                    <Button
                        Command="{Binding SetNewItemTypeCommand}"
                        CommandParameter="Outcome"
                        Foreground="{Binding NewBudgetItem.BudgetType, Converter={StaticResource ActiveBudgetTypeToBrushConverter}, ConverterParameter='Outcome'}"
                        Style="{StaticResource ToolButtonStyle}">
                        <icons:PackIconFontAwesome Kind="MinusSolid" Style="{StaticResource MediumIconSize}" />
                    </Button>
                </StackPanel>

                <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextBlockFilterCaption}">Сумма</TextBlock>
                <TextBox
                    Width="40"
                    Height="24"
                    DockPanel.Dock="Left"
                    Text="{Binding NewBudgetItem.Amount, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextBlockFilterCaption}">Заголовок</TextBlock>
                <TextBox
                    Width="150"
                    Height="24"
                    DockPanel.Dock="Left"
                    Text="{Binding NewBudgetItem.Title, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock DockPanel.Dock="Left" Foreground="#40D650">Категория</TextBlock>
                <ComboBox
                    Width="100"
                    Height="24"
                    DisplayMemberPath="Name"
                    DockPanel.Dock="Left"
                    IsTextSearchCaseSensitive="False"
                    IsTextSearchEnabled="True"
                    IsEditable="True"
                    Foreground="Black"
                    ItemsSource="{Binding AvailableCategories}"
                    Text="{Binding NewCategoryName}"
                    SelectedValue="{Binding NewBudgetItem.Category, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextBlockFilterCaption}">Описание</TextBlock>
                <TextBox Margin="4,2,6,2" Text="{Binding NewBudgetItem.Description}" />
            </DockPanel>
        </StackPanel>


        <Grid
            Grid.Row="1"
            Grid.Column="1"
            MinHeight="250"
            Margin="0,3,0,0"
            Background="#D61B1818">
            <lc:CartesianChart
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Series="{Binding SeriesCollection}"
                SeriesColors="{Binding SeriesColors}">
                <lc:CartesianChart.AxisX>
                    <lc:Axis Title="Дата" />
                </lc:CartesianChart.AxisX>
                <lc:CartesianChart.AxisY>
                    <lc:Axis Title="Сумма" />
                </lc:CartesianChart.AxisY>
            </lc:CartesianChart>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Grid.Column="0"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Visible">
            <ItemsControl Background="Transparent" ItemsSource="{Binding FilteredSource}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="2,2,2,6"
                            Padding="2"
                            Background="#E4333333"
                            BorderBrush="RoyalBlue"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>


                                <icons:PackIconFontAwesome
                                    Grid.Column="0"
                                    Margin="2,2,6,2"
                                    Foreground="{Binding BudgetType, Converter={StaticResource BudgetTypeToBrushConverter}}"
                                    Kind="{Binding BudgetType, Converter={StaticResource BudgetTypeToIconConverter}}"
                                    Style="{StaticResource MediumIconSize}" />

                                <icons:PackIconFontAwesome
                                    Grid.Column="1"
                                    Margin="2,2,6,2"
                                    Foreground="{Binding BudgetType, Converter={StaticResource BudgetTypeToBrushConverter}}"
                                    Kind="{Binding Category.Icon}"
                                    Style="{StaticResource MediumIconSize}" />


                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    Foreground="White"
                                    Text="{Binding Amount}" />
                                <TextBlock
                                    Grid.Column="3"
                                    FontSize="13"
                                    Foreground="White"
                                    Text="{Binding Created.LocalDateTime, StringFormat={}{0:dd.MM.yyyy (ddd)}, ConverterCulture=ru-RU}" />

                                <TextBlock
                                    Grid.Column="4"
                                    Margin="12,2,2,2"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding Title}" />

                                <icons:PackIconFontAwesome
                                    Grid.Column="5"
                                    Margin="2,2,6,2"
                                    Foreground="DarkGray"
                                    Kind="InfoSolid"
                                    Style="{StaticResource MediumIconSize}"
                                    ToolTip="{Binding Description}" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>


</UserControl>
