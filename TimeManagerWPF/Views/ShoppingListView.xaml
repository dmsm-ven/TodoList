<UserControl x:Class="TodoList.WPF.Views.ShoppingListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TodoList.WPF.ViewModels"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=vm:ShoppingListViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="900">
    <beh:Interaction.Triggers>
        <beh:EventTrigger EventName="Loaded">
            <beh:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </beh:EventTrigger>
    </beh:Interaction.Triggers>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="../Assets/Images/ShoppingList/shopping-background.jpg"
                        TileMode="Tile" Viewport="0,0,300,300" ViewportUnits="Absolute"/>
        </Grid.Background>
        <Grid>
            <Grid.Background>
                <SolidColorBrush Color="Black" Opacity="0.8"/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding AddNewItemCommand}" Style="{StaticResource ToolButtonStyle}" >
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconFontAwesome Kind="PlusSolid" />
                        </StackPanel>
                    </Button>
                    
                    <TextBlock Text="Добавить" VerticalAlignment="Center" Margin="12 2 2 2" Foreground="White"/>
                    <TextBox Width="250"
                             Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             FontWeight="Bold"
                             VerticalAlignment="Center"
                             Foreground="#E9FF6A"
                             Margin="12 2 2 2"
                             VerticalContentAlignment="Bottom"
                             HorizontalContentAlignment="Left"
                             BorderThickness="0 0 0 1" BorderBrush="White" Background="Transparent" />
                </StackPanel>
             
                <Button Grid.Column="2" Command="{Binding ShowHiddenToggleCommand}" Style="{StaticResource ToolButtonStyle}" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ShowHiddenTitle}" VerticalAlignment="Center" Margin="2 2 12 2"/>
                        <icons:PackIconFontAwesome Kind="{Binding ShowHiddenIcon}" />
                    </StackPanel>
                </Button>
            </Grid>
            
            <ItemsControl Grid.Row="1" ItemsSource="{Binding FilteredItems}" 
                          Margin="10 40"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          HorizontalAlignment="Center">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0AEFD2"/>
                                    <Setter Property="VerticalAlignment" Value="Bottom" />
                                    <Setter Property="Padding" Value="0 0 0 6"/>
                                    <Setter Property="Margin" Value="8 2 8 2"/>
                                </Style>
                            </Grid.Resources>

                            <TextBlock Grid.Column="0" 
                                       Text="{Binding DateAdded, StringFormat=dd.MM.yyyy}"
                                       ToolTip="Дата создания"/>
                            <TextBox Text="{Binding Name}" 
                                     Width="400"
                                     IsReadOnly="True"
                                     Grid.Column="1"
                                     Margin="4"
                                     FontSize="18"
                                     Padding="3 5"
                                     Foreground="White"
                                     Background="Transparent"
                                     BorderThickness="0 0 0 1"
                                     BorderBrush="#A9DE1F"/>

                            <Button Grid.Column="2" Command="{Binding ToggleStatusCommand}" 
                                    ToolTip="Отметить как выполненное"
                                    Foreground="#A4AE3F"
                                    BorderThickness="0"
                                    Margin="12 2 2 2"
                                    Cursor="Hand"
                                    Background="Transparent">
                                <icons:PackIconFontAwesome Kind="{Binding StateIcon}" />
                            </Button>
                            
                            <TextBlock Grid.Column="3" Text="{Binding DatePurchased,  StringFormat=dd.MM.yyyy}"
                                       ToolTip="Дата выполнения"/>
                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
