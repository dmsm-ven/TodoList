<UserControl x:Class="TodoList.WPF.Views.ReadListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:TodoList.WPF.ViewModels"
             xmlns:con="clr-namespace:TodoList.WPF.Infrastructure.Converters"
             xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=vm:ReadListViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="900">
    <beh:Interaction.Triggers>
        <beh:EventTrigger EventName="Loaded">
            <beh:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </beh:EventTrigger>
    </beh:Interaction.Triggers>
    <Grid>
        <Grid.Resources>
            <con:ReadedBookOpacityConverter x:Key="ReadedBookOpacityConverter" />
        </Grid.Resources>
        <Grid.Background>
            <ImageBrush ImageSource="../Assets/Images/ReadList/texture-2.jpg"
                        TileMode="Tile" Viewport="0,0,200,200" ViewportUnits="Absolute"/>
        </Grid.Background>
        <Grid>
            <Grid.Background>
                <SolidColorBrush Color="#031016" Opacity="0.9"/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
             </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Панель с добавлением новой книги | кнопка отображения скрытых -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    BorderThickness="0" Margin="0 0 0 20" BorderBrush="#D6CFD3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="10 2"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </Grid.Resources>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding AddBookCommand}" Style="{StaticResource ToolButtonStyle}" >
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconFontAwesome Kind="{Binding AddBookIconStateKind}" 
                                                           Style="{StaticResource MediumIconSize}" />
                                <TextBlock Text="Добавить книгу" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelAddingBookCommand}"
                                Foreground="#ff2400"
                                        Visibility="{Binding IsAddNewBookPanelShow, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Style="{StaticResource ToolButtonStyle}">
                            <icons:PackIconFontAwesome Kind="TimesSolid" Style="{StaticResource ExtraSmallIconSize}" />
                        </Button>
                    </StackPanel>
                    
                    <!-- Скрытая панель добавления новой книги, отображается после нажатия '+' -->
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" 
                                Visibility="{Binding IsAddNewBookPanelShow, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#DED2B6"/>
                                <Setter Property="Margin" Value="6 4"/>
                            </Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Margin" Value="6 4"/>
                                <Setter Property="Height" Value="24" />
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0 0 0 1"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </Grid.Resources>

                        <TextBlock Grid.Column="0" Text="Название новой книги" />
                        <TextBox Grid.Column="1" Text="{Binding NewBook.Name, UpdateSourceTrigger=PropertyChanged}" d:Text="Название книги" />

                        <TextBlock Grid.Column="2" Text="Автор" />
                        <TextBox Grid.Column="3" Text="{Binding NewBook.Author}" d:Text="Автор" />

                        <TextBlock Grid.Column="4" Text="URL обложки" />
                        <TextBox Grid.Column="5" Text="{Binding NewBook.Image}" d:Text="https://google.com/" />
                    </Grid>

                    <Button Grid.Column="2" Command="{Binding ShowHiddenToggleCommand}" Style="{StaticResource ToolButtonStyle}" >
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ShowHiddenTitle}" VerticalAlignment="Center" Margin="2 2 12 2"/>
                            <icons:PackIconFontAwesome Kind="{Binding ShowHiddenIconState}" Style="{StaticResource MediumIconSize}" />
                        </StackPanel>
                    </Button>

                </Grid>
            </Border>

            <!-- Все книги -->
            <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredBooks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#594D5F" BorderThickness="1" Margin="8">
                                <Border.Effect>
                                    <DropShadowEffect Direction="300"
                                                      Color="#4083A09F" 
                                                      ShadowDepth="8"
                                                      BlurRadius="4"/>
                                </Border.Effect>
                                <Grid>
                                    <Border Background="#9ACB3A">
                                        <Image Height="220" Width="160" 
                                               Panel.ZIndex="0"
                                               Opacity="{Binding IsAlreadyReaded, Converter={StaticResource ReadedBookOpacityConverter}}"
                                               Source="{Binding CachedImage}"
                                               ToolTip="{Binding Name}" Stretch="Fill"/>
                                    </Border>

                                    <Button Command="{Binding ToggleStatusCommand}" 
                                            Panel.ZIndex="1"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ShowHideBookButton}">
                                        <icons:PackIconFontAwesome Kind="{Binding StateIcon}" 
                                                                   Style="{StaticResource LargeIconSize}" />

                                    </Button>
                                
                                    <TextBlock d:Text="01.01.2022" 
                                               Text="{Binding DateEnded, StringFormat=dd.MM.yyyy}"
                                               Panel.ZIndex="2"
                                               Foreground="Gray"      
                                               Visibility="{Binding IsAlreadyReaded, Converter={StaticResource BoolToVisibilityConverter}}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"></TextBlock>
                                    <TextBlock d:Text="01.01.2022" 
                                               Text="{Binding DateAdded, StringFormat=dd.MM.yyyy}"
                                               Panel.ZIndex="2"
                                               Foreground="Gray"                                          
                                               HorizontalAlignment="Left" VerticalAlignment="Top"></TextBlock>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Скрытая панель прочтенных книг -->
            <ScrollViewer Grid.Row="1" Grid.Column="1" 
                          Visibility="{Binding IsShowHidden, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl>
                    <ItemsControl ItemsSource="{Binding ReadedBooks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="14 2 8 2"
                                               VerticalAlignment="Center"
                                               Foreground="White" FontWeight="Bold">
                                        <Run Text="{Binding DateAdded, StringFormat='dd.MM.yyyy'}"/>
                                        <Run Text=" - "/>
                                        <Run Text="{Binding DateEnded, StringFormat='dd.MM.yyyy'}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Author}" 
                                               Margin="2 2 8 2"
                                           FontSize="14"
                                           Foreground="Beige" TextDecorations="Strikethrough"/>
                                    <TextBlock Text="{Binding Name}" 
                                               Margin="2 2 8 2"
                                           FontSize="15"
                                           Foreground="LightCoral" TextDecorations="Strikethrough"/>
                                    
                                </StackPanel>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
