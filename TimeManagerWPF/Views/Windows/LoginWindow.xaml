<Window
    x:Class="TodoList.WPF.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TodoList.WPF.ViewModels"
    x:Name="loginWindow"
    Title="Войти"
    Width="900"
    Height="700"
    d:DataContext="{d:DesignInstance Type=vm:LoginWindowViewModel,
                                     IsDesignTimeCreatable=True}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ToolWindow"
    mc:Ignorable="d">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="../../Assets/Images/Login/login-background.jpeg" Stretch="UniformToFill" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Padding="50,100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="12">
            <Border.Background>
                <SolidColorBrush Opacity="0.8" Color="#353C3A" />
            </Border.Background>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#F1F1E5" />
                        <Setter Property="Margin" Value="4" />
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground" Value="Yellow" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#85D1DC" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="FontSize" Value="16" />
                    </Style>

                    <Style TargetType="PasswordBox">
                        <Setter Property="Foreground" Value="Yellow" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#85D1DC" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="FontSize" Value="16" />
                    </Style>
                    <Style TargetType="{x:Type icons:PackIconFontAwesome}">
                        <Setter Property="Foreground" Value="Gray" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="6,2,6,2" />

                    </Style>
                </Grid.Resources>

                <Image
                    Grid.Row="0"
                    Width="150"
                    Height="100"
                    Margin="20,40,20,20"
                    Source="../../Assets/Images/Login/login-logo.png" />

                <DockPanel Grid.Row="1" Margin="10,0,10,10">
                    <icons:PackIconFontAwesome Kind="UserSolid" />
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <DockPanel Grid.Row="2" Margin="10,0,10,10">
                    <icons:PackIconFontAwesome Kind="KeyboardSolid" />
                    <PasswordBox x:Name="passwordBox" PasswordChar="●" />
                </DockPanel>

                <DockPanel Grid.Row="3" Margin="10,0,10,10">
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding SavePasswordToggleCommand}">
                        <icons:PackIconFontAwesome Kind="{Binding SavePasswordIconState}" />
                    </Button>

                    <TextBlock FontSize="9" Text="Сохранить пароль до перезагрузки компьютера" />
                </DockPanel>

                <Button
                    Grid.Row="4"
                    Width="120"
                    Margin="4"
                    Padding="4,8"
                    Command="{Binding LoginCommand}"
                    CommandParameter="{Binding ElementName=passwordBox}"
                    Content="Войти"
                    Style="{StaticResource LoginButtonStyle}" />

                <TextBlock
                    Grid.Row="5"
                    Margin="10,20,10,10"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Foreground="#E9AC1B"
                    Text="Не правильный логин/пароль!"
                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='hidden'}" />
            </Grid>
        </Border>

    </Grid>

</Window>
