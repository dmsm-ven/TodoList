<UserControl x:Class="TodoList.WPF.Controls.TodoTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TodoList.WPF.ViewModels"
             xmlns:converters="clr-namespace:TodoList.WPF.Infrastructure.Converters"
             xmlns:con="clr-namespace:TodoList.WPF.Controls"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"             
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TodoListViewModel, IsDesignTimeCreatable=True}"
             d:Background="White"             
             d:DesignHeight="300" d:DesignWidth="1200">
    <Grid>
        <Grid.Resources>
            <converters:HasActiveTaskBrushConverter x:Key="HasActiveTaskBrushConverter"/>
            <converters:IsActiveMonthForegroundBrushConverter x:Key="IsActiveMonthForegroundBrushConverter"/>
        </Grid.Resources>

        <TabControl ItemsSource="{Binding Tabs}"
                    SelectedValue="{Binding SelectedTab}"
                    BorderThickness="0">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" >
                        <Ellipse Width="24" Height="24" Stroke="Transparent" 
                                 Fill="{Binding HasActiveTask, Converter={StaticResource HasActiveTaskBrushConverter}}"/>
                        <TextBlock Text="{Binding EmployeerName}" 
                                   Margin="8 2 2 2"
                                   FontWeight="Bold" FontSize="20" Foreground="#FF576D68"/>

                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush>
                                <LinearGradientBrush.GradientStops>
                                    <GradientStop Color="WhiteSmoke" Offset="0"/>
                                    <GradientStop Color="GhostWhite" Offset="0.5" />
                                </LinearGradientBrush.GradientStops>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Row="0">
                            <Button Style="{StaticResource ToolButtonStyle}" 
                                    Command="{Binding AddNewJobItemCommand}"
                                    Foreground="LightGreen">
                                <icons:PackIconFontAwesome Kind="PlusSolid"  />
                            </Button>
                            <TextBlock Text="Добавить задачу"  
                                       FontSize="18"
                                       Foreground="DarkGray"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                        
                        <TextBlock Foreground="Navy" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Grid.Row="1"
                                   FontSize="26" 
                                   Text="{Binding SelectedMonthPill.DisplayName}"/>

                        <DataGrid ItemsSource="{Binding FilteredTodoItems}" 
                                  Grid.Row="2"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  VerticalGridLinesBrush="Transparent"
                                  HorizontalGridLinesBrush="LightGray"
                                  RowHeight="30"
                                  AutoGenerateColumns="False">
                            <DataGrid.Resources>
                                <Style TargetType="CheckBox">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Width" Value="28"/>
                                    <Setter Property="LayoutTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" 
                                                    Binding="{Binding StartDate, StringFormat='dd.MM.yyyy'}" 
                                                    Width="65"/>
                                <DataGridTextColumn Header="Задача" Width="2*"
                                                    Binding="{Binding Title}"/>
                                <DataGridTextColumn Header="Сайт" 
                                                    Binding="{Binding Website}"/>
                                <DataGridTemplateColumn Header="Цена">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Price}" 
                                                       Margin="8 2"
                                                       FontSize="16"
                                                       Foreground="Navy" 
                                                       FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Price}" 
                                                     Margin="8 2"
                                                     Padding="4 2"
                                                     FontSize="16"
                                                     Foreground="Navy"
                                                     BorderThickness="0 0 0 2" BorderBrush="Gray" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Оплачено">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsPayed}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Выполнено">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsCompleted}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="img">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ToolButtonStyle}" 
                                                    Command="{Binding OpenScreenshotsFolderCommand}"
                                                    Foreground="Gray" 
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasScreenshots, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <icons:PackIconFontAwesome Kind="ImageRegular" Width="20" Height="20"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Примечание" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <ScrollViewer Grid.Row="3" 
                                      BorderThickness="0" 
                                      MinHeight="30"                                     
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding MonthPills}"
                                     BorderBrush="LightGray" BorderThickness="0 1 0 0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button 
                                            Background="RoyalBlue"
                                            MinWidth="80"
                                            HorizontalContentAlignment="Center"
                                             Margin="2 2 8 2"
                                             Padding="8 2 8 4"
                                             FontSize="18"                                            
                                             Command="{Binding MonthPillClickCommand}"
                                             Content="{Binding DisplayName}"
                                             Foreground="{Binding IsActive, Converter={StaticResource IsActiveMonthForegroundBrushConverter}}"
                                             FontWeight="Bold" >
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</UserControl>
