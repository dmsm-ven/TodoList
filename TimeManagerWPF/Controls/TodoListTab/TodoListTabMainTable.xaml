<UserControl x:Class="TodoList.WPF.Controls.TodoListTabMainTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:beh="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:TodoList.WPF.ViewModels"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TodoListTabViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="200" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Основная таблица задач -->
        <DataGrid ItemsSource="{Binding FilteredTodoItems}" 
                  SelectedValue="{Binding SelectedJobItem}" 
                  Grid.Row="0"
                  FontSize="15"
                  CanUserAddRows="False"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  CanUserDeleteRows="False"
                  BorderThickness="0"
                  VerticalGridLinesBrush="Transparent"
                  Background="Transparent"
                  RowBackground="Transparent"
                  HeadersVisibility="Column"
                  HorizontalGridLinesBrush="LightGray"
                  RowHeight="28"
                  SelectionMode="Single"
              RowDetailsVisibilityMode="VisibleWhenSelected"
                  AutoGenerateColumns="False">
            <DataGrid.Resources>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Foreground" Value="Black" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2AF19F5C" />
                            <Setter Property="BorderBrush" Value="#2AF19F5C" />
                            
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompleted}" Value="false">
                            <Setter Property="FontWeight" Value="SemiBold"></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Создано">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StartDate, StringFormat='dd.MM.yyyy'}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="Blue"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="дн." Foreground="Gray"
                                    Width="30"
                                    IsReadOnly="True"
                                    Binding="{Binding DaysAgo, Mode=OneWay}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Задача" Width="2*" Binding="{Binding Title,Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Сайт" 
                                    Width="300"
                                    Binding="{Binding Website, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <DataGridTextColumn Header="Цена" 
                                    Width="150"
                                    Binding="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTemplateColumn Header="Оплачено">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <icons:PackIconFontAwesome 
                            Foreground="{Binding IsPayed, 
                                Converter={StaticResource BoolToBrushConverter}, 
                                ConverterParameter='#7cfc00;#ff2400'}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Kind="{Binding IsPayed, Converter={StaticResource BoolToIconKindConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsPayed, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Выполнено">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <icons:PackIconFontAwesome 
                            Foreground="{Binding IsCompleted, 
                                Converter={StaticResource BoolToBrushConverter}, 
                                ConverterParameter='#7cfc00;#ff2400'}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Kind="{Binding IsCompleted, Converter={StaticResource BoolToIconKindConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="img">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ToolButtonStyle}"
                                        Padding="2"
                                        Command="{Binding OpenScreenshotsFolderCommand}"
                                        Foreground="{Binding HasScreenshots, Converter={StaticResource HasActiveTaskBrushConverter}}" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <icons:PackIconFontAwesome Kind="ImageRegular" Foreground="Blue" Width="16" Height="16"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        
        <!-- Панель с примечанием к выделеной задаче -->
        <Grid Grid.Row="1" Visibility="{Binding SelectedJobItem, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Примечание: " 
                            Margin="8 4 4 4"
                            Foreground="#AAAAAA" 
                            FontSize="14" Grid.Row="0"/>
            <TextBox Grid.Row="1" Text="{Binding SelectedJobItem.Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Margin="4" Padding="4" BorderBrush="#B3B3C9" BorderThickness="0 0 0 1">
            </TextBox>
        </Grid>
    </Grid>
    
</UserControl>
