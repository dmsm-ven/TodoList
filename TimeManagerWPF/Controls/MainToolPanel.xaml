<UserControl x:Class="TodoList.WPF.Controls.MainToolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:TodoList.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TodoListViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="50" d:DesignWidth="1000">

    <DockPanel>
        <DockPanel.Background>
            <SolidColorBrush Color="#FF2A48F1" Opacity="0.75"/>
        </DockPanel.Background>
        <DockPanel.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6 2 30 2"/>
                <Setter Property="Foreground" Value="FloralWhite"/>
            </Style>
            <Style TargetType="{x:Type Button}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </DockPanel.Resources>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button Command="{Binding MoveToTodoListCommand}" Style="{StaticResource ToolButtonStyle}">
                <icons:PackIconFontAwesome Kind="ListSolid"/>
            </Button>
            <TextBlock Text="К списку задач" />
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button Command="{Binding AddJobItemCommand}" Style="{StaticResource ToolButtonStyle}">
                <icons:PackIconFontAwesome Kind="PlusSolid"/>
            </Button>
            <TextBlock Text="Добавить задачу" />
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Opacity="0.25" DockPanel.Dock="Left">
            <Button Command="{Binding DeleteJobItemCommand}"  Style="{StaticResource ToolButtonStyle}">
                <icons:PackIconFontAwesome Kind="MinusSolid"/>
            </Button>
            <TextBlock Text="Удалить задачу" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Opacity="0.25" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Command="{Binding AddEmployeerCommand}"  Style="{StaticResource ToolButtonStyle}">
                <icons:PackIconFontAwesome Kind="UserPlusSolid"/>
            </Button>
            <TextBlock Text="Добавить вкладку" />
        </StackPanel>

    </DockPanel>
</UserControl>
