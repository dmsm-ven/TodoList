<UserControl x:Class="TodoList.WPF.Controls.MainToolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:TodoList.WPF.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ToolPanelViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="60" Height="60" d:DesignWidth="1000">

    <StackPanel Background="{StaticResource ToolPanelBackground}" Orientation="Horizontal">
        <StackPanel.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6 2 30 2"/>
                <Setter Property="Foreground" Value="FloralWhite"/>
            </Style>
            <Style TargetType="{x:Type Button}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
        </StackPanel.Resources>
         
        <Button Command="{Binding MoveToTodoListCommand}" 
                Style="{StaticResource ToolButtonStyle}" DockPanel.Dock="Left">
            <StackPanel Orientation="Horizontal">
                <icons:PackIconFontAwesome Kind="ListSolid"  />
                <TextBlock Text="Список задач" />
            </StackPanel>
        </Button>

        <Button Command="{Binding MoveToShoppingListCommand}" 
                Style="{StaticResource ToolButtonStyle}" DockPanel.Dock="Left">
            <StackPanel Orientation="Horizontal">
                <icons:PackIconFontAwesome Kind="ShoppingBagSolid"/>
                <TextBlock Text="Список покупок" />
            </StackPanel>
        </Button>

        <Button Command="{Binding MoveToReadListCommand}" 
                Style="{StaticResource ToolButtonStyle}" DockPanel.Dock="Left">
            <StackPanel Orientation="Horizontal">
                <icons:PackIconFontAwesome Kind="BookOpenSolid"/>
                <TextBlock Text="Список на прочтение" />
            </StackPanel>
        </Button>
    
    </StackPanel>
</UserControl>
