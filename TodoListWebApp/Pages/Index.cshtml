@page
@using TodoListApp.DataAccess.Entities
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="employeer_tabs__panel">
    <div class="employeer_tabs__left">
        <ul class="employeer_tabs__nav_list">
            @if(Model.Employeers is not null)
            {
                foreach (EmployeerEntity item in Model.Employeers)
                {
                    <li>
                        <a asp-page-handler="ChangeEmployeer" asp-route-id="@item.id"
                           class="btn btn-sm @(item.id == Model.SelectedEmployeer?.id ? "btn-danger" : "btn-outline-primary")">@item.name</a>
                    </li>
                }
            }
        </ul>
    </div>
    <div class="employeer_tabs__right">
        <h2>Список задач для выбранного </h2>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Дата</th>
                        <th>Задание</th>
                        <th>Сайт</th>
                        <th>Цена</th>
                        <th>Оплачено</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SelectedEmployeerTasks is not null)
                    {
                        foreach (var item in Model.SelectedEmployeerTasks)
                        {
                            <tr>
                                <td>@item.start_date.ToLocalTime().DateTime.ToShortDateString()</td>
                                <td>@item.title</td>
                                <td>@item.website</td>
                                <td>@item.price</td>
                                <td>
                                    <input type="checkbox" 
                                    id="task@(item.id)-payed" checked=@item.is_payed /></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
